# Copy to .env (gitignored) and fill in only what you need.
# Claude Code headless mode is the DEFAULT backend and needs NO key here --
# it uses your existing `claude` login. See docs/DECISIONS.md D1.

# Backend: claude_code (default) | anthropic_api
LLM_BACKEND=claude_code

# Only needed if LLM_BACKEND=anthropic_api
ANTHROPIC_API_KEY=

# Recommended, free to obtain (dashboard.composio.dev). With it, the "already
# on Composio?" check uses the real composio SDK (composio.client.toolkits.list,
# fully paginated -- see agent/composio_check.py). Without it, falls back to a
# keyless public docs index, which agrees with the SDK on all 100 apps in this
# study but is a secondary source (D8, D27).
COMPOSIO_API_KEY=

# Pro usage limits are per rolling window -- keep this low.
CONCURRENCY=3
