# Copy to .env (gitignored) and fill in only what you need.
# Claude Code headless mode is the DEFAULT backend and needs NO key here --
# it uses your existing `claude` login. See docs/DECISIONS.md D1.

# Backend: claude_code (default) | anthropic_api
LLM_BACKEND=claude_code

# Only needed if LLM_BACKEND=anthropic_api
ANTHROPIC_API_KEY=

# Optional. Without it the "already on Composio?" check falls back to the public
# toolkits page, which can prove presence but not absence (D8).
COMPOSIO_API_KEY=

# Pro usage limits are per rolling window -- keep this low.
CONCURRENCY=3
